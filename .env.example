# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API auth (stage 4)
ADMIN_MASTER_TOKEN=

# App
CORS_ALLOWED_ORIGINS=https://your-portfolio-domain.com
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Recommendation agent (method 2) -- Groq LLM acting as a real MCP client
# against this server's own MCP server object, in-process (see
# recommend_agent.py). Free tier at console.groq.com.
GROQ_API_KEY=
# Check console.groq.com/docs/models for currently-supported models --
# Groq periodically retires older ones (this replaced llama-3.3-70b-versatile
# after Groq removed it, which silently 404'd every /api/v1/recommend call).
GROQ_MODEL=openai/gpt-oss-120b
