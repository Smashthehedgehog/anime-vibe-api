# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API auth (stage 4)
ADMIN_MASTER_TOKEN=

# App
CORS_ALLOWED_ORIGINS=https://your-portfolio-domain.com
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Recommendation agent (method 2) -- Groq LLM acting as a real MCP client
# against this server's own /sse endpoint. Free tier at console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Where the agent connects to reach its own MCP server -- usually just
# the app's own base URL + /sse. Override if deployed somewhere the
# service can't reach itself at 127.0.0.1 (e.g. behind a proxy).
INTERNAL_MCP_URL=http://127.0.0.1:8000/sse
